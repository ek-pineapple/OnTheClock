# On the Clock — environment template
#
# THIS FILE IS COMMITTED. Placeholders only — never a real value, not even a
# project id or a stack URL. Copy it to .env (which is gitignored) and fill
# that in instead.
#
# See docs/setup.md for where each value comes from and when it is needed.
# Rings 0-1 (core/ and tests/) require none of this.

# ---------------------------------------------------------------------------
# Grafana Cloud
# ---------------------------------------------------------------------------

# Your stack URL, e.g. https://yourstack.grafana.net
GRAFANA_URL=

# Service account token — what mcp-grafana authenticates with.
# Administration -> Users and access -> Service accounts
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Metrics push (Mimir / Prometheus). Stack -> Prometheus -> Send Metrics.
# The Influx line-protocol path on the same host is /api/v1/push/influx/write
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
GRAFANA_PROM_TOKEN=

# Logs push (Loki). Stack -> Loki -> Send Logs.
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_TOKEN=

# ---------------------------------------------------------------------------
# Google Cloud
# ---------------------------------------------------------------------------

# The project *ID*, not the display name. Get it with:
#   gcloud config get-value project
# IDs are lowercase and usually carry a numeric suffix (my-project-123456).
GOOGLE_CLOUD_PROJECT=

# Vertex AI region for Gemini. Independent of where Firestore lives — the two
# services are located separately. us-central1 has the broadest model
# availability; verify your chosen region serves the model you want.
GOOGLE_CLOUD_LOCATION=us-central1

# Route ADK/Gemini through Vertex AI rather than the AI Studio key path,
# so everything stays under one project and one credential.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Firestore database id. "(default)" unless you named one at creation.
#   gcloud firestore databases list
FIRESTORE_DATABASE=(default)

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# How often the monitor loop re-evaluates and pushes. Seconds.
MONITOR_TICK_SECONDS=15

# Where the web app looks for the API.
VITE_API_BASE_URL=http://localhost:8000
